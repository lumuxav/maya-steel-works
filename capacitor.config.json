{
  "appId": "com.mayasteelworks.management",
  "appName": "Maya Steel Works",
  "webDir": "mobile-shell",
  "server": {
    "url": "https://maya-steel-works-mgt.vercel.app",
    "cleartext": false,
    "allowNavigation": [
      "maya-steel-works-mgt.vercel.app"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DEFAULT",
      "hidden": false,
      "animation": "NONE"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true,
      "autoBackdropColor": "dom"
    }
  }
}
